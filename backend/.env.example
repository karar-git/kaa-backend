# Copy to .env for local dev. NEVER commit the real file.
# Railway: set these under Variables in the service settings.

# Where results/ and static/ live. Defaults to backend/data.
DATA_DIR=

# Comma-separated allowed origins, or * for any.
CORS_ORIGINS=*

# Optional. Enables POST /api/explain only. Without it every other route works.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
